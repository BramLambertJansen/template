# Test-stack voor de runner (ADR 0009): alleen op het interne netwerk test-net, geen poorten op de host.
# Lokale demo-waarden, nooit echt. scripts/runner.sh geeft dit bestand altijd mee (nooit .env.local).
APP_ENV=test
DATABASE_URL=postgres://api_user:api_user@test-db:5432/app
AUTH_DATABASE_URL=postgres://auth_service:auth_service@test-db:5432/app
MIGRATOR_DATABASE_URL=postgres://app_migrator:app_migrator@test-db:5432/app?sslmode=disable
