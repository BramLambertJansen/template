{
  "name": "app-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=26.11 <27"
  },
  "browserslist": [
    "safari >= 16.4",
    "chrome >= 111",
    "firefox >= 128"
  ],
  "imports": {
    "#core/*": "./src/core/*",
    "#api/*": "./src/api/*",
    "#web/*": "./src/web/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --write",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 prettier --ignore-unknown --check",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "gate:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
