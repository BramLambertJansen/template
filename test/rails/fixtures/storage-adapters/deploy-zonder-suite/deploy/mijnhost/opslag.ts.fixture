import { defineFileStorage } from '#core/api/storage/port.ts';

export const hostAdapter = defineFileStorage({
  createUploadUrl: () => ({ url: 'https://host.example/up', method: 'PUT', headers: {} }),
  createDownloadUrl: () => ({ url: 'https://host.example/down' }),
  stat: () => Promise.resolve(null),
  delete: () => Promise.resolve(),
  uploadOrigin: 'https://host.example',
});
