import { defineFileStorage } from '#core/api/storage/port.ts';

export function createMijnStorage(dir: string) {
  return defineFileStorage({
    createUploadUrl: () => ({ url: `https://opslag.example/${dir}/up`, method: 'PUT', headers: {} }),
    createDownloadUrl: () => ({ url: `https://opslag.example/${dir}/down` }),
    stat: () => Promise.resolve(null),
    delete: () => Promise.resolve(),
    uploadOrigin: 'https://opslag.example',
  });
}
