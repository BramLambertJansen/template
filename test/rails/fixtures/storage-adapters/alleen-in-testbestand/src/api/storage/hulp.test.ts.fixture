import { defineFileStorage } from '#core/api/storage/port.ts';

// defineFileStorage in een testbestand is geen adapter van de app.
export const testAdapter = defineFileStorage({
  createUploadUrl: () => ({ url: 'https://test.example/up', method: 'PUT', headers: {} }),
  createDownloadUrl: () => ({ url: 'https://test.example/down' }),
  stat: () => Promise.resolve(null),
  delete: () => Promise.resolve(),
  uploadOrigin: null,
});
