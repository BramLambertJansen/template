{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)",
      "Bash(gh pr merge*)",
      "Bash(gh api *merge*)",
      "Bash(docker *)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(pnpm i *)",
      "Bash(pnpm update *)",
      "Bash(pnpm up *)",
      "Bash(pnpm upgrade *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm rm *)",
      "Bash(pnpm uninstall *)",
      "Bash(pnpm un *)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Edit(docs/framework.md)",
      "Edit(docs/dod.md)",
      "Edit(docs/roadmap.md)",
      "Edit(docs/adr/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(db/init/**)",
      "Edit(db/docker/**)",
      "Edit(compose.yaml)",
      "Edit(package.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(pnpm-workspace.yaml)",
      "Edit(mise.toml)",
      "Edit(eslint.config.*)",
      "Edit(tsconfig*.json)",
      "Edit(.dependency-cruiser.*)",
      "Edit(lefthook.yml)",
      "Edit(renovate.json)",
      "Edit(src/core/**)",
      "Edit(src/api/env.ts)",
      "Edit(src/shared/permissions.ts)",
      "Edit(.gitattributes)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "pnpm test:db",
      "pnpm db:reset",
      "pnpm db:types",
      "pnpm ui:check",
      "pnpm gate:slow"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com"
      ]
    }
  }
}
