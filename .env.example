# Lokale demo-waarden. Kopieer naar .env.local (fase 1: pnpm dev doet dit). Nooit echte geheimen.
# DATABASE_ADMIN_URL alleen voor scripts/ (migraties, tests), nooit in src/. De API verbindt als api_user, auth als auth_service.
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54322/app
DATABASE_URL=postgres://api_user:api_user@127.0.0.1:54322/app
AUTH_DATABASE_URL=postgres://auth_service:auth_service@127.0.0.1:54322/app
AUTH_SECRET=local-demo-secret-change-per-environment-000000
SMTP_URL=smtp://127.0.0.1:54325
